---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImageGallery from '../../components/ImageGallery.astro';
import ProductCard from '../../components/ProductCard.astro';
import { formatPrice } from '../../lib/format';
import { slugifyCategory } from '../../lib/catalog';
import { hasVariants, resolveVariant } from '../../lib/variants';
import { filterEntries } from '../../lib/products';
import { STORE } from '../../config';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const data = product.data;
const base = { id: product.id, ...data };

const multiVariant = hasVariants(base);
const resolved = multiVariant
  ? data.variants!.map((_, i) => resolveVariant(base, i))
  : [resolveVariant(base)];
const active = resolved.find((v) => v.inStock) ?? resolved[0];

function stockState(stock: number): 'out' | 'low' | 'ok' {
  if (stock <= 0) return 'out';
  if (stock <= 10) return 'low';
  return 'ok';
}

type Block = { type: 'p'; text: string } | { type: 'ul'; items: string[] };
const blocks: Block[] = [];
if (data.longDescription) {
  for (const chunk of data.longDescription.split(/\n{2,}/)) {
    const lines = chunk.split('\n').map((l) => l.trim()).filter(Boolean);
    const listItems = lines.filter((l) => l.startsWith('- '));
    if (listItems.length === lines.length && listItems.length > 0) {
      blocks.push({ type: 'ul', items: listItems.map((l) => l.slice(2)) });
    } else {
      blocks.push({ type: 'p', text: lines.join(' ') });
    }
  }
}

const all = await getCollection('products');
const others = all.filter((p) => p.id !== product.id);
const relatedSlug = data.species === 'ambos' ? 'perro' : data.species;
const related = [
  ...filterEntries(others, { category: slugifyCategory(data.category) }),
  ...filterEntries(others, { species: relatedSlug }),
]
  .filter((p, i, arr) => arr.findIndex((x) => x.id === p.id) === i)
  .slice(0, 4);

const speciesLabel = { perro: 'Perros', gato: 'Gatos', ambos: 'Perros y gatos' }[data.species];
const foodLabel = data.foodType === 'seco' ? 'Alimento seco' : data.foodType === 'humido' ? 'Alimento húmedo' : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.name,
  description: data.description,
  brand: { '@type': 'Brand', name: data.brand },
  image: data.images.map((i) => new URL(i, Astro.site).href),
  category: data.category,
  offers: {
    '@type': 'Offer',
    price: active.price,
    priceCurrency: STORE.currency,
    availability: active.inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
};
---

<BaseLayout title={data.name} description={data.description}>
  <div class="container-page py-8">
    <nav class="mb-6 flex flex-wrap items-center gap-1.5 text-sm text-muted" aria-label="Ruta">
      <a href="/" class="hover:text-foreground">Inicio</a>
      <span>/</span>
      <a href={`/productos/?cat=${slugifyCategory(data.category)}`} class="hover:text-foreground">{data.category}</a>
      <span>/</span>
      <span class="text-foreground">{data.name}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-2">
      <ImageGallery images={data.images} alt={data.name} badge={data.badge} />

      <div class="lg:pt-2">
        <a href={`/productos/?marca=${slugifyCategory(data.brand)}`} class="text-xs font-bold uppercase tracking-wide text-brand-secondary hover:underline">{data.brand}</a>
        <h1 class="mt-2 text-3xl font-extrabold leading-tight tracking-tight">{data.name}</h1>
        <p class="mt-3 text-muted">{data.description}</p>

        <div class="mt-6 flex flex-wrap items-end gap-3">
          <span class="text-3xl font-extrabold tracking-tight tabular-nums" data-price>{formatPrice(active.price)}</span>
          <span class="text-lg text-muted line-through tabular-nums" data-compare hidden={!active.compareAtPrice}>
            {active.compareAtPrice ? formatPrice(active.compareAtPrice) : ''}
          </span>
          <span class="pill bg-gift text-foreground" data-discount hidden={active.discount <= 0}>-{active.discount}% OFF</span>
          <span class="pill bg-gift text-foreground" data-gift hidden={active.bonusKg <= 0}>+{active.bonusKg}kg de regalo</span>
        </div>

        {
          multiVariant && (
            <div class="mt-6">
              <p class="mb-2 text-sm font-semibold">Elegí el tamaño</p>
              <div class="flex flex-wrap gap-2" data-variant-switcher>
                {resolved.map((v) => (
                  <button
                    type="button"
                    class="variant-btn"
                    data-variant
                    data-active={v.index === active.index}
                    data-price={v.price}
                    data-compare={v.compareAtPrice ?? ''}
                    data-discount={v.discount}
                    data-bonus={v.bonusKg}
                    data-stock={v.stockLabel}
                    data-stock-state={stockState(v.stock)}
                    data-in-stock={String(v.inStock)}
                    data-cart-id={v.cartId}
                    data-label={v.label ?? ''}
                    aria-pressed={v.index === active.index}
                  >{v.label}</button>
                ))}
              </div>
            </div>
          )
        }

        <p class="mt-4 text-sm font-semibold" data-stock data-state={stockState(active.stock)}>{active.stockLabel}</p>

        {
          active.inStock ? (
            <div class="mt-6 flex flex-wrap items-center gap-3">
              <div class="flex items-center rounded-full border border-border">
                <button type="button" data-qty-dec class="grid h-11 w-11 place-items-center rounded-full text-lg text-muted hover:bg-muted-bg" aria-label="Restar">−</button>
                <input
                  data-qty-input
                  type="number"
                  min="1"
                  value="1"
                  inputmode="numeric"
                  class="w-12 border-0 bg-transparent text-center text-base font-semibold tabular-nums focus:outline-none"
                  aria-label="Cantidad"
                />
                <button type="button" data-qty-inc class="grid h-11 w-11 place-items-center rounded-full text-lg text-muted hover:bg-muted-bg" aria-label="Sumar">+</button>
              </div>
              <button
                type="button"
                class="btn-cta flex-1 py-3"
                data-add-to-cart
                data-add-id={active.cartId}
                data-add-name={data.name}
                data-add-price={active.price}
                data-add-image={data.images[0]}
                data-add-variant={active.label ?? ''}
                data-add-qty-target="[data-qty-input]"
              >
                Agregar al carrito
              </button>
            </div>
          ) : (
            <button type="button" class="btn-outline mt-6 w-full py-3" disabled>Sin stock</button>
          )
        }

        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 border-t border-border pt-6 text-sm">
          <div>
            <dt class="text-muted">Marca</dt>
            <dd class="font-medium">{data.brand}</dd>
          </div>
          <div>
            <dt class="text-muted">Indicado para</dt>
            <dd class="font-medium">{speciesLabel}</dd>
          </div>
          <div>
            <dt class="text-muted">Categoría</dt>
            <dd class="font-medium">{data.category}</dd>
          </div>
          {foodLabel && (
            <div>
              <dt class="text-muted">Tipo</dt>
              <dd class="font-medium">{foodLabel}</dd>
            </div>
          )}
          <div class="col-span-2">
            <dt class="text-muted">Entrega</dt>
            <dd class="font-medium">{STORE.shippingNote}</dd>
          </div>
        </dl>

        {
          data.tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {data.tags.map((tag) => (
                <span class="rounded-full bg-muted-bg px-3 py-1 text-xs font-medium text-muted">#{tag}</span>
              ))}
            </div>
          )
        }
      </div>
    </div>

    {
      blocks.length > 0 && (
        <section class="mt-16 max-w-3xl border-t border-border pt-10">
          <h2 class="text-xl font-extrabold tracking-tight">Detalles del producto</h2>
          <div class="mt-4 space-y-4 text-foreground/85">
            {blocks.map((block) =>
              block.type === 'p' ? (
                <p>{block.text}</p>
              ) : (
                <ul class="space-y-2">
                  {block.items.map((item) => (
                    <li class="flex gap-2.5">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-secondary" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              ),
            )}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-16">
          <h2 class="mb-6 text-xl font-extrabold tracking-tight">También te puede interesar</h2>
          <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
            {related.map((p) => <ProductCard product={p} />)}
          </div>
        </section>
      )
    }
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script>
    import { formatPrice } from '../../lib/format';

    const input = document.querySelector<HTMLInputElement>('[data-qty-input]');
    if (input) {
      document.querySelector('[data-qty-inc]')?.addEventListener('click', () => {
        input.value = String((parseInt(input.value, 10) || 1) + 1);
      });
      document.querySelector('[data-qty-dec]')?.addEventListener('click', () => {
        input.value = String(Math.max(1, (parseInt(input.value, 10) || 1) - 1));
      });
      input.addEventListener('change', () => {
        const v = parseInt(input.value, 10);
        input.value = String(Math.max(1, Number.isFinite(v) ? v : 1));
      });
    }

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-variant]');
      if (!btn) return;

      const price = Number(btn.dataset.price ?? 0);
      const compare = Number(btn.dataset.compare || 0);
      const discount = Number(btn.dataset.discount ?? 0);
      const bonus = Number(btn.dataset.bonus ?? 0);
      const inStock = btn.dataset.inStock === 'true';
      const label = btn.dataset.label ?? '';

      document.querySelectorAll<HTMLElement>('[data-variant]').forEach((b) => {
        const isActive = b === btn;
        b.dataset.active = String(isActive);
        b.setAttribute('aria-pressed', String(isActive));
      });

      const priceEl = document.querySelector<HTMLElement>('[data-price]');
      const compareEl = document.querySelector<HTMLElement>('[data-compare]');
      const discountEl = document.querySelector<HTMLElement>('[data-discount]');
      const giftEl = document.querySelector<HTMLElement>('[data-gift]');
      const stockEl = document.querySelector<HTMLElement>('[data-stock]');
      const addBtn = document.querySelector<HTMLButtonElement>('[data-add-to-cart]');

      if (priceEl) priceEl.textContent = formatPrice(price);
      if (compareEl) {
        compareEl.textContent = compare ? formatPrice(compare) : '';
        compareEl.hidden = compare <= 0;
      }
      if (discountEl) {
        discountEl.textContent = `-${discount}% OFF`;
        discountEl.hidden = discount <= 0;
      }
      if (giftEl) {
        giftEl.textContent = `+${bonus}kg de regalo`;
        giftEl.hidden = bonus <= 0;
      }
      if (stockEl) {
        stockEl.textContent = btn.dataset.stock ?? '';
        stockEl.dataset.state = btn.dataset.stockState ?? 'ok';
      }
      if (addBtn) {
        addBtn.dataset.addId = btn.dataset.cartId ?? '';
        addBtn.dataset.addPrice = String(price);
        addBtn.dataset.addVariant = label;
        addBtn.disabled = !inStock;
        addBtn.textContent = inStock ? 'Agregar al carrito' : 'Sin stock';
      }
    });
  </script>
</BaseLayout>

<style>
  .variant-btn {
    border: 1px solid var(--color-border);
    background: #fff;
    color: var(--color-muted);
    border-radius: 9999px;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .variant-btn:hover {
    border-color: var(--color-foreground);
    color: var(--color-foreground);
  }
  .variant-btn[data-active='true'] {
    border-color: var(--color-brand-secondary);
    background: var(--color-brand-secondary-tint);
    color: var(--color-brand-secondary);
  }
  [data-stock] {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  [data-stock]::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-success);
  }
  [data-stock][data-state='out']::before {
    background: var(--color-danger);
  }
  [data-stock][data-state='low']::before {
    background: var(--color-warning);
  }
  [data-stock][data-state='ok']::before {
    background: var(--color-success);
  }
</style>
